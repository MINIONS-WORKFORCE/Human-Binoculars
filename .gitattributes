# Normalize line endings so Windows and macOS teammates produce identical diffs
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files: never diff or merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.fits binary
*.fz binary

# Preserve byte-for-byte catalogue records and their provenance hashes.
fixtures/sources/* -text -whitespace
